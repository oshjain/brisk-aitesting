{
  "name": "brisk-aitesting",
  "version": "0.1.1",
  "description": "AI-native modular testing engine for SaaS, APIs, UI workflows, and contracts.",
  "type": "module",
  "license": "MIT",
  "author": "Hasmukh Jain",
  "contributors": [
    "Hasmukh Jain"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oshjain/brisk-aitesting.git"
  },
  "bugs": {
    "url": "https://github.com/oshjain/brisk-aitesting/issues"
  },
  "homepage": "https://github.com/oshjain/brisk-aitesting#readme",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "brisk-aitesting": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "docs",
    "examples",
    "reference-apps",
    "fixtures",
    "assets"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc",
    "smoke": "node smoke/run-smoke.mjs",
    "smoke:contracts": "node smoke/run-contracts.mjs",
    "smoke:engine-conformance": "node smoke/run-engine-conformance.mjs",
    "smoke:plugin-conformance": "node smoke/run-plugin-conformance.mjs",
    "smoke:schemathesis": "node smoke/run-schemathesis-smoke.mjs",
    "smoke:reference-serious-saas": "node smoke/run-reference-serious-saas.mjs",
    "smoke:golden-fixtures": "node smoke/run-golden-fixtures.mjs",
    "smoke:cli": "node smoke/run-cli.mjs",
    "smoke:ai-fixtures": "node smoke/run-ai-fixtures.mjs",
    "smoke:real-ai": "node smoke/run-real-ai-smoke.mjs",
    "smoke:ci": "npm run smoke:contracts && npm run smoke:engine-conformance && npm run smoke:plugin-conformance && npm run smoke:reference-serious-saas && npm run smoke:golden-fixtures && npm run smoke:cli && npm run smoke:ai-fixtures && npm run smoke && npm run pack:check",
    "smoke:all": "npm run smoke:ci && npm run smoke:real-ai",
    "benchmark": "node smoke/run-benchmark.mjs",
    "pack:check": "npm run build && node smoke/run-pack-check.mjs",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.52.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "yaml": "^2.9.0"
  }
}
