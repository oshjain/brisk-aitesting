{
  "name": "brisk-aitesting",
  "version": "0.1.8",
  "description": "Locally embeddable software testing engine using AI planning and precise execution.",
  "type": "module",
  "license": "MIT",
  "author": "Hasmukh Jain",
  "contributors": [
    "Hasmukh Jain"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oshjain/brisk-aitesting.git"
  },
  "bugs": {
    "url": "https://github.com/oshjain/brisk-aitesting/issues"
  },
  "homepage": "https://github.com/oshjain/brisk-aitesting#readme",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "brisk-aitesting": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "adapters",
    "docs",
    "examples",
    "reference-apps",
    "fixtures",
    "assets"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "npm run clean && tsc",
    "smoke": "node smoke/run-smoke.mjs",
    "smoke:contracts": "node smoke/run-contracts.mjs",
    "smoke:engine-conformance": "node smoke/run-engine-conformance.mjs",
    "smoke:plugin-conformance": "node smoke/run-plugin-conformance.mjs",
    "smoke:extension-conformance": "node smoke/run-extension-conformance.mjs",
    "smoke:adapter-readiness": "node smoke/run-adapter-readiness.mjs",
    "smoke:schemathesis": "node smoke/run-schemathesis-smoke.mjs",
    "smoke:specmatic": "node smoke/run-specmatic-smoke.mjs",
    "smoke:pact": "node smoke/run-pact-smoke.mjs",
    "smoke:reference-serious-saas": "node smoke/run-reference-serious-saas.mjs",
    "smoke:reference-proof-apps": "node smoke/run-reference-proof-apps.mjs",
    "smoke:golden-fixtures": "node smoke/run-golden-fixtures.mjs",
    "smoke:cli": "node smoke/run-cli.mjs",
    "smoke:ai-fixtures": "node smoke/run-ai-fixtures.mjs",
    "smoke:real-ai": "node smoke/run-real-ai-smoke.mjs",
    "smoke:ci": "npm run smoke:contracts && npm run smoke:engine-conformance && npm run smoke:plugin-conformance && npm run smoke:extension-conformance && npm run smoke:adapter-readiness && npm run smoke:reference-serious-saas && npm run smoke:reference-proof-apps && npm run smoke:pact && npm run smoke:golden-fixtures && npm run smoke:cli && npm run smoke:ai-fixtures && npm run smoke && npm run pack:check",
    "smoke:all": "npm run smoke:ci && npm run smoke:real-ai",
    "try:local": "npm run build && npm run smoke:cli && npm run smoke:reference-serious-saas",
    "benchmark": "npm run build && node smoke/run-benchmark.mjs",
    "pack:check": "npm run build && node smoke/run-pack-check.mjs",
    "release:check": "npm run typecheck && npm run build && npm run smoke:ci && npm run benchmark && node smoke/run-release-readiness.mjs",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "clean:artifacts": "node dist/cli.js clean"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.52.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@pact-foundation/pact": "^17.0.1",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^22.0.0",
    "specmatic": "^2.51.0",
    "tailwindcss": "^4.3.3"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "typescript": "^5.8.0",
    "yaml": "^2.9.0"
  }
}
